# Copy this file to .env in the project root and fill in real values.
# Nothing in this repo will run live trades or send messages without these.

# --- Broker ---
# tradingview | alpaca
# "tradingview" (default) routes orders to TradingView's built-in Paper Trading
# simulator through the tradingview-mcp CLI. It needs NO API keys -- just
# TradingView Desktop running with CDP enabled and a broker connected in the
# Trading panel (Trade -> Paper Trading -> Connect).
BROKER_PROVIDER=tradingview

# paper | live  -- ALWAYS start with paper. live requires ALLOW_LIVE_TRADING=true below too.
# On TradingView this also decides whether --allow-live is passed to the CLI;
# leaving it as paper makes a real-money order impossible even if a live
# brokerage happens to be the one connected in TradingView.
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false

# --- TradingView (BROKER_PROVIDER=tradingview) ---
# Path to the tradingview-mcp checkout. Defaults to a sibling of this repo.
TRADINGVIEW_MCP_PATH=
# Only set if `node` isn't on PATH.
NODE_BIN=node
TRADINGVIEW_TIMEOUT_SECONDS=60

# --- Alpaca (BROKER_PROVIDER=alpaca only) ---
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview -> API Keys
# Live keys only needed once TRADING_MODE=live and you have explicitly reviewed the risk.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Telegram briefings ---
# Create a bot via @BotFather on Telegram, then message it once and fetch your chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk ---
STARTING_EQUITY=100000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DRAWDOWN_PCT=10.0
CORRELATION_BLOCK_THRESHOLD=0.7

# --- Economic calendar blackout (market intelligence) ---
# Pauses NEW entries around scheduled high-impact releases, so positions are
# never sized off an ATR that the next print invalidates. Exits and the
# drawdown kill-switch are never gated by this. No API key needed.
EVENT_FILTER_ENABLED=true
# 1 low / 2 medium / 3 high
EVENT_MIN_IMPORTANCE=3
EVENT_BLACKOUT_MINUTES_BEFORE=60
EVENT_BLACKOUT_MINUTES_AFTER=30
# What to do if the calendar can't be reached. false = trade through it with a
# logged warning (default); true = refuse new entries whenever it's unknown.
EVENT_FILTER_FAIL_CLOSED=false
